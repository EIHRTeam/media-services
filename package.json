{
  "name": "@eihrteam/mps-worker",
  "version": "1.1.0",
  "description": "Write XMP metadata and C2PA provenance into images, in the browser or Node",
  "homepage": "https://github.com/EIHRTeam/media-services#readme",
  "bugs": {
    "url": "https://github.com/EIHRTeam/media-services/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIHRTeam/media-services.git"
  },
  "bin": {
    "mps": "./dist/cli.js"
  },
  "files": [
    "dist/index.*",
    "dist/errors.*",
    "dist/loader.*",
    "dist/result.*",
    "dist/controls.*",
    "dist/batch.*",
    "dist/node.*",
    "dist/worker.*",
    "dist/cli.*",
    "js/index.ts",
    "js/errors.ts",
    "js/loader.ts",
    "js/result.ts",
    "js/controls.ts",
    "js/batch.ts",
    "js/node.ts",
    "js/worker.ts",
    "js/cli.ts",
    "pkg/media_services_wasm*",
    "pkg/THIRD_PARTY_LICENSES.txt",
    "docs/performance.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm-binary": "./pkg/media_services_wasm_bg.wasm",
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:presets": "node scripts/gen-presets.mjs",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:js": "tsc -p tsconfig.json",
    "build": "pnpm gen:presets && pnpm build:wasm && pnpm build:js && pnpm gen:licenses",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "gen:identity": "cargo test -p provenance --test identity",
    "test": "pnpm gen:identity && node --test test/*.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "prepack": "pnpm build && pnpm check:bundle",
    "bench": "node scripts/bench.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.26.0"
}
